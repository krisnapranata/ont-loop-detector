# Salin file ini menjadi .env lalu isi. JANGAN commit file .env.
# Catatan: jangan menaruh komentar di belakang nilai pada baris yang sama.

# --- GenieACS (NBI). Di server ACS sendiri biasanya http://127.0.0.1:7557
GENIEACS_URL=http://127.0.0.1:7557
GENIEACS_USER=
GENIEACS_PASSWORD=

# --- Switch Cisco (hanya perintah "show" yang dijalankan)
# CISCO_TRANSPORT: telnet atau ssh
CISCO_HOST=
CISCO_PORT=23
CISCO_TRANSPORT=telnet
CISCO_USER=
CISCO_PASSWORD=
CISCO_ENABLE_PASSWORD=

# --- Router MikroTik lewat SSH (hanya perintah "print"; cukup user grup read)
MIKROTIK_HOST=
MIKROTIK_PORT=22
MIKROTIK_USER=
MIKROTIK_PASSWORD=

# --- Topologi jaringan
# HOTSPOT_SUBNETS boleh lebih dari satu, pisahkan dengan koma
# TR069_INTERFACE = nama interface TR069 di router
# OLT_TRUNKS = port switch yang menuju OLT
HOTSPOT_SUBNETS=10.8.0.0/20
HOTSPOT_VLAN=200
TR069_VLAN=100
TR069_INTERFACE=vlan100-MNG-TR069
OLT_TRUNKS=Gi1/0/47,Gi1/0/48

# --- Ambang deteksi (boleh dibiarkan)
FLAP_WINDOW_SEC=180
FLAP_MIN_EVENTS=3
LOOP_MIN_FLAPPING_MACS=3
RECENT_REBOOT_HOURS=6
SCORE_STRONG=60
SCORE_RISK=30

# --- Jadwal
FAST_INTERVAL_SEC=30
ACS_INTERVAL_SEC=300
RETENTION_DAYS=14

# --- Telegram (kosongkan bila tidak dipakai)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_COOLDOWN_MIN=15

# --- Dashboard
WEB_HOST=0.0.0.0
WEB_PORT=8088
WEB_USER=admin
WEB_PASSWORD=
