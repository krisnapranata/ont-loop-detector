  "charts": {
   "online": {
    "label": "Status",
    "slices": {
     "1_online": {
      "label": "Online",
      "color": "#3f8fd6",
      "filter": [
       ">",
       [
        "PARAM",
        "Events.Inform"
       ],
       [
        "-",
        [
         "FUNC",
         "NOW"
        ],
        [
         "*",
         5,
         60000
        ]
       ]
      ]
     },
     "2_24h": {
      "label": "Offline < 24 jam",
      "color": "#e0a000",
      "filter": [
       "AND",
       [
        "<",
        [
         "PARAM",
         "Events.Inform"
        ],
        [
         "-",
         [
