       [
        ">",
        [
         "PARAM",
         "Events.Inform"
        ],
        [
         "-",
         [
          "FUNC",
          "NOW"
         ],
         86400000
        ]
       ]
      ]
     },
     "3_lama": {
      "label": "Offline > 24 jam",
      "color": "#c43c3c",
      "filter": [
       "<",
       [
        "PARAM",
        "Events.Inform"
       ],
       [
        "-",
        [
         "FUNC",
         "NOW"
        ],
        86400000
       ]
      ]
     }
    }
   },
   "vendor": {
    "label": "Merek",
    "slices": {
     "1_fh": {
      "label": "FiberHome",
      "color": "#2f9e5b",
      "filter": [
       "=",
       [
        "PARAM",
        "DeviceID.Manufacturer"
       ],
       "FiberHome"
      ]
     },
     "2_hw": {
      "label": "Huawei",
      "color": "#3f6fd6",
      "filter": [
       "LIKE",
       [
        "PARAM",
        "DeviceID.Manufacturer"
       ],
       "Huawei%"
      ]
     },
     "3_zte": {
      "label": "ZTE",
      "color": "#d9631e",
      "filter": [
       "=",
       [
        "PARAM",
        "DeviceID.Manufacturer"
       ],
       "ZTE"
      ]
     },
     "4_lain": {
      "label": "Lainnya",
      "color": "#6b7280",
      "filter": [
       "AND",
       [
        "<>",
        [
         "PARAM",
         "DeviceID.Manufacturer"
        ],
        "FiberHome"
       ],
       [
        "NOT LIKE",
        [
         "PARAM",
         "DeviceID.Manufacturer"
        ],
        "Huawei%"
       ],
       [
        "<>",
        [
         "PARAM",
         "DeviceID.Manufacturer"
        ],
        "ZTE"
       ]
      ]
     }
    }
   },
   "rx": {
    "label": "Sinyal RX",
    "slices": {
     "1_baik": {
      "label": "Baik",
      "color": "#2f9e5b",
      "filter": [
       "AND",
       [
        "IS NOT NULL",
        [
         "PARAM",
         "VirtualParameters.RXPower"
        ]
       ],
       [
        "<",
        [
         "PARAM",
         "VirtualParameters.RXPower"
        ],
        "-24"
       ]
      ]
     },
