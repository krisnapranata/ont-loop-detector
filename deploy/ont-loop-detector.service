[Unit]
Description=ONT Loop Detector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ontloop
WorkingDirectory=/opt/ont-loop-detector
ExecStart=/opt/ont-loop-detector/.venv/bin/python -m app.main
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
